# Anbernic RG34XXSP / NextUI H700 hardware profile.
export BATTERY_STATUS="/sys/class/power_supply/axp2202-battery/status"
export POWER_STATUS="/sys/class/power_supply/axp2202-usb/online"
export CAPACITY_STATUS="/sys/class/power_supply/axp2202-battery/capacity"
export BATTERY_REGS="/sys/kernel/debug/regmap/5-0034/registers"
export HALL_KEY="/sys/class/power_supply/axp2202-battery/hallkey"
export BL_TYPE="TYPE1"
export SYSFS_BL_COMMAND="/sys/kernel/debug/dispdbg/command"
export SYSFS_BL_NAME="/sys/kernel/debug/dispdbg/name"
export SYSFS_BL_PARAM="/sys/kernel/debug/dispdbg/param"
export SYSFS_BL_START="/sys/kernel/debug/dispdbg/start"
export BL_COMMAND="setbl"
export BL_NAME="lcd0"
export AUDIO_PROFILE="h700"
export TRIMPOD_BT_MIXER_DEVICE="bluealsa"
ZOOMVAL="2"
